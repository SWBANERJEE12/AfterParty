# Vite (client) — copy to .env.local
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# WebRTC voice — JSON array of { "urls", "username?", "credential?" }. Add TURN for production.
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Optional WebRTC viewer target for host-file mode (default 10; room max_members is separate in DB)
# VITE_PLAYBACK_SYNC_TARGET=10

# Supabase Dashboard → Authentication → disable email confirm for local dev (optional)
# Username login uses synthetic email: username@auth.afterparty.local (see src/auth/username.ts)

# Express (server) — project root only; loaded on server start via server/loadEnv.ts
# Use .env and/or .env.local (.env.local overrides). Both are gitignored — never commit real keys.
PORT=3001
OMDB_API_KEY=
# YouTube Data API v3 key (API key credential — not OAuth client ID). Server-only; do not use VITE_ prefix.
YOUTUBE_API_KEY=

# Optional legacy LiveKit token route (not used by watch-room WebRTC voice UI)
SUPABASE_SERVICE_ROLE_KEY=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional alias for server-side Supabase admin (defaults to VITE_SUPABASE_URL)
# SUPABASE_URL=
